generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id           String     @id @default(uuid()) @map("restaurant")
  name         String     @db.VarChar(200)
  address      String?    @db.VarChar(500)
  phone        String?    @db.VarChar(50)
  description  String?    @db.VarChar(1000)
  settings     Json?      @map("settings")
  webSettings  Json?      @map("web_settings")
  totemSettings Json?     @map("totem_settings")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  categories   Category[]
  orders       Order[]
  users        User[]
  templates    MenuTemplate[]

  @@map("restaurant")
}

model Category {
  id           String    @id @default(uuid()) @map("category")
  name         String    @db.VarChar(100)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("category")
}

model Product {
  id          String      @id @default(uuid()) @map("product")
  name        String      @db.VarChar(100)
  description String?     @db.VarChar(500)
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?     @db.VarChar(2048)
  isActive    Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("product")
}

model Order {
  id           String      @id @default(uuid()) @map("order")
  tableNumber  Int
  status       OrderStatus @default(PENDING)
  total        Decimal     @db.Decimal(10, 2)
  observations String?     @db.VarChar(500)
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("order")
}

model OrderItem {
  id        String  @id @default(uuid()) @map("order_item")
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_item")
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model User {
  id                String    @id @default(uuid()) @map("user")
  email             String    @unique @db.VarChar(255)
  password          String
  restaurantId      String?
  restaurant        Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  role              UserRole  @default(STAFF)
  refreshToken      String?   @map("refresh_token")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("user")
}

enum UserRole {
  ADMIN
  STAFF
}

model MenuTemplate {
  id           String   @id @default(uuid()) @map("menu_template")
  restaurantId String?  @map("restaurant_id")
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  isActive     Boolean  @default(false) @map("is_active")
  isSystem     Boolean  @default(false) @map("is_system")
  config       Json     @db.Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  schedules    TemplateSchedule[]

  @@map("menu_template")
}

model TemplateSchedule {
  id         String        @id @default(uuid()) @map("template_schedule")
  templateId String
  template   MenuTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  type       ScheduleType @default(DAY_OF_WEEK) @map("schedule_type")
  days       String[]      @default([]) @map("days")
  startTime  String?       @db.VarChar(5) @map("start_time")
  endTime    String?       @db.VarChar(5) @map("end_time")
  date       DateTime?     @map("date")
  pattern    String?       @map("pattern")
  priority   Int           @default(0) @map("priority")
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@map("template_schedule")
}

enum ScheduleType {
  DAY_OF_WEEK
  TIME_RANGE
  DATE
  RECURRING
}
